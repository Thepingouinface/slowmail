APP_NAME=SlowMail
APP_ENV=production
APP_KEY=
# Laisser à false : une page d'erreur de debug peut afficher les variables d'environnement.
APP_DEBUG=false
APP_URL=http://localhost:8080

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Docker : les journaux vont sur stderr (docker compose logs). Jamais de corps de mail dedans.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# SQLite par défaut. Sous Docker, DB_DATABASE est fixé par docker-compose.yml (volume nommé).
DB_CONNECTION=sqlite
# DB_DATABASE=/chemin/vers/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Pas de worker : l'envoi est synchrone dans slowmail:tick.
QUEUE_CONNECTION=sync
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# --- SlowMail ---------------------------------------------------------------

# Interface : mot de passe unique. Vide = personne ne peut se connecter.
SLOWMAIL_PASSWORD=

# Kill switch global : tant que ce n'est pas "true", aucun mail ne part.
SLOWMAIL_ENABLED=false

# L'activation d'une campagne est refusée si le texte fixe du corps ne contient pas cette chaîne
# (sans tenir compte de la casse). Vide : retombe sur « stop », le garde-fou ne se désactive pas.
SLOWMAIL_OPTOUT_TEXT=stop

# Un mail planifié part seulement s'il a moins de N minutes de retard, sinon il est replanifié.
SLOWMAIL_GRACE_MINUTES=30

# Reply-To (par défaut : MAIL_FROM_ADDRESS).
SLOWMAIL_REPLY_TO=

# Fuseau des heures affichées hors d'une campagne (bandeau d'état, liste de suppression).
# Une campagne affiche ses heures dans son propre fuseau (réglage de la campagne).
SLOWMAIL_TIMEZONE=Europe/Paris

# Port exposé sur 127.0.0.1 par docker-compose.
SLOWMAIL_PORT=8080

# --- SMTP (OVH) ---------------------------------------------------------------
# Les identifiants ne vivent que dans ce fichier .env.

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=ssl0.ovh.net
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
